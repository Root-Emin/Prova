# Prova backend configuration.
#
# Copy to .env and fill in the secrets. .env is git-ignored; never commit it.

# --- Ortam ---
# production, katı yapılandırma doğrulamasını açar: eksik JWT secret, eksik
# pepper, varsayılan Mongo URI veya EMAIL_PROVIDER=none ile sunucu boot etmez.
# Ayrıca GraphQL playground ve introspection zorla kapatılır.
APP_ENV=development

# --- Server ---
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- PostgreSQL (identity: who is this?) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=masterfabric
DB_PASSWORD=masterfabric
DB_NAME=masterfabric
DB_SSLMODE=disable

# --- MongoDB (object database: what was played and how was it scored?) ---
MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=prova

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- JWT ---
# Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION_HOURS=24
JWT_ISSUER=prova

# --- Passwordless authentication ---
# There is no password in this system. The only credential is a six-digit code
# mailed to a verified address, so every limit below is load-bearing.
#
# AUTH_CODE_PEPPER is the server-side secret mixed into the stored code digest.
# The code space is only 10^6, so without a pepper a leaked digest column is a
# rainbow table away from plaintext. Generate with: openssl rand -base64 32
AUTH_CODE_PEPPER=
AUTH_CODE_LENGTH=6
AUTH_CODE_TTL_SECONDS=600
AUTH_CODE_MAX_ATTEMPTS=5
AUTH_CODE_RESEND_COOLDOWN_SECONDS=60
AUTH_CODE_MAX_REQUESTS_PER_EMAIL=5
AUTH_CODE_MAX_REQUESTS_PER_IP=20
AUTH_CODE_RATE_LIMIT_WINDOW_SECONDS=3600
# Every login response is padded to this floor so that a registered address and
# an unknown one cannot be told apart with a stopwatch.
AUTH_MIN_RESPONSE_TIME_MS=400
# Creates the account on first successful code redemption. Turn off once
# organisation invitations exist.
AUTH_SELF_SIGNUP=true

# --- Transactional e-mail ---
# The application depends on the notification.Sender port, never on a provider
# package. Switching provider means a new adapter plus this one value.
#   resend - deliver through the Resend API
#   smtp   - deliver over SMTP (geliştirmede Mailpit)
#   none   - refuse to send (fails loudly; never prints codes to the console)
# production'da "none" ile boot durur: parolasız girişte e-posta teslimi
# olmadan hiç kimse sisteme giremez ama sunucu çalışıyor görünür.
EMAIL_PROVIDER=smtp
# Send from a dedicated subdomain, not the root domain: transactional volume
# affects sender reputation, and a subdomain keeps a problem away from corporate
# mail. Set once DNS is configured — see .notes/DECISIONS.md §7.
EMAIL_FROM_ADDRESS=noreply@mail.<alanadi>
EMAIL_FROM_NAME=Prova
EMAIL_REPLY_TO=
EMAIL_TIMEOUT_SECONDS=10

RESEND_API_KEY=
RESEND_BASE_URL=https://api.resend.com
# The sending region the domain was registered in. Recorded so the deployment
# and the DNS records (the bounce MX in particular) stay in sync.
RESEND_REGION=eu-west-1

# SMTP (geliştirmede Mailpit: docker compose up mailpit, arayüz :8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false

# --- GraphQL ---
# Tüm istemci API yüzeyi GraphQL'dir; REST yalnızca /health/* ve /metrics.
# Derinlik ve karmaşıklık limitleri isteğe bağlı değil: iç içe geçmiş tek bir
# sorgu veritabanını kilitleyebilir.
GRAPHQL_PLAYGROUND=true
GRAPHQL_INTROSPECTION=true
GRAPHQL_MAX_DEPTH=12
GRAPHQL_MAX_COMPLEXITY=500
GRAPHQL_MAX_BATCH=5

# --- Token yaşam döngüsü ---
# Access token kısa ömürlüdür; oturumun devamı rotasyonlu refresh token'a
# bağlıdır. Kullanılmış bir refresh token tekrar geldiğinde ailenin tamamı
# iptal edilir.
TOKEN_ACCESS_TTL_SECONDS=900
TOKEN_REFRESH_TTL_SECONDS=2592000
TOKEN_MAGIC_LINK_TTL_SECONDS=900
TOKEN_DEVICE_CHALLENGE_TTL_SECONDS=120
TOKEN_MAX_FAILED_ATTEMPTS=10
TOKEN_LOCK_DURATION_SECONDS=900
# Magic link'in açılacağı web arayüzünün kökü. Electron deep-link bilerek
# kullanılmaz: deep-link, token'ı şemayı kaydeden her uygulamaya açar.
WEB_BASE_URL=http://localhost:3000

# --- LLM taşıma katmanı ---
# Model adı ve sağlayıcı BURADA DEĞİLDİR. İkisi de llm_profiles koleksiyonundan
# okunur ve yönetici ekranından çalışma anında değiştirilebilir.
LLM_REQUEST_TIMEOUT_SECONDS=60
LLM_CIRCUIT_THRESHOLD=3
LLM_CIRCUIT_COOLDOWN_SECONDS=30
LLM_LONG_INPUT_THRESHOLD=4000
# Ham ses backend'e hiç gelmez; istemci yalnızca metin gönderir. Bu anahtar
# varsayılan olarak kapalıdır ve kapalı kalmalıdır.
LLM_STORE_RAW_AUDIO=false

# --- Hesap yaşam döngüsü ---
# Silme talebi ile kalıcı silme arasındaki geri alma penceresi. Test
# edilebilmesi için env'den ayarlanır.
LIFECYCLE_DELETION_GRACE_SECONDS=2592000
LIFECYCLE_PURGE_INTERVAL_SECONDS=3600
LIFECYCLE_PURGE_ENABLED=true

# --- Kafka ---
# Prova süreç içi olay veri yolunu kullanır. Kafka wiring'i kaldırıldı; bu
# anahtarlar yalnızca geriye dönük uyumluluk için duruyor.
KAFKA_ENABLED=false
KAFKA_BROKERS=localhost:9092

# --- Logging ---
LOG_LEVEL=info
LOG_FORMAT=json
