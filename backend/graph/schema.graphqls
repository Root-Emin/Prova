# Prova GraphQL şeması.
#
# Bu dosya istemci API yüzeyinin tamamıdır. REST yalnızca /health/live,
# /health/ready ve /metrics için kalır; üçü de kimlik doğrulaması olmadan,
# sabit yolda ve makine tarafından okunmak zorundadır.

# ---------------------------------------------------------------------------
# Skalerler ve directive'ler
# ---------------------------------------------------------------------------

scalar Time
scalar UUID
scalar JSON

"""
Geçerli bir oturum token'ı ister.

Şema seviyesinde uygulanır, middleware'de değil: kod isteme ve kod doğrulama
mutation'ları token'sız çağrılmak zorundadır, ve HTTP seviyesinde bir kapı
bunu ayırt edemez.
"""
directive @auth on FIELD_DEFINITION | OBJECT

"""
Adı verilen izni ister.

Yetki yoksa hata fırlatılmaz, alan null döner. Böylece bir kullanıcının
göremediği tek alan sorgunun tamamını patlatmaz — puanı görebilen ama ezme
kaydını göremeyen bir çalışan, puanını yine de görür. Nullable olmayan
alanlarda null döndürmek GraphQL'de geçersiz olduğu için oralarda hata
döner.
"""
directive @permission(requires: String!) on FIELD_DEFINITION

# ---------------------------------------------------------------------------
# Kimlik
# ---------------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  """Silme talebi verilmiş, geri alma penceresi içinde."""
  PENDING_DELETION
  """Kalıcı silme işi çalışmış; kişisel veri artık yok."""
  DELETED
}

type User {
  id: UUID!
  email: String!
  firstName: String!
  lastName: String!
  status: UserStatus!
  emailVerified: Boolean!
  "Token'a yazılan etkin kiracı."
  organizationId: UUID!
  permissions: [String!]!
  "Silme talebinin verildiği an. Doluysa hesap geri alma penceresinde."
  deletionRequestedAt: Time
  "Kalıcı silmenin planlandığı an."
  deletionScheduledAt: Time
  createdAt: Time!
}

enum DevicePlatform {
  WINDOWS
  MACOS
  LINUX
  WEB
  UNKNOWN
}

type Device {
  id: UUID!
  name: String!
  platform: DevicePlatform!
  lastSeenAt: Time!
  revokedAt: Time
  "Anahtar çifti kayıtlı mı. Değilse cihaz yalnızca eski parmak izi eşleşmesiyle tanınır."
  hasPublicKey: Boolean!
  createdAt: Time!
}

type PairedDevice {
  id: UUID!
  name: String!
  platform: DevicePlatform!
  "Bu makineden ilk giriş. Yeni cihaz bildirimini tetikleyen de budur."
  isNew: Boolean!
}

type AuthPayload {
  accessToken: String!
  "Rotasyonlu yenileme zincirinin bu andaki halkası."
  refreshToken: String!
  expiresAt: Time!
  organizationId: UUID!
  user: User!
  device: PairedDevice
}

"""
Kod isteme yanıtı.

Adresin bir hesaba ait olup olmadığına dair hiçbir sinyal taşımaz: kayıtlı
adres, bilinmeyen adres ve limitlenmiş adres için aynı gövde döner.
"""
type RequestLoginCodePayload {
  "Her zaman true. 'İstek kabul edildi' demektir, 'e-posta çıktı' değil."
  sent: Boolean!
  expiresInSeconds: Int!
  resendAfterSeconds: Int!
}

type RegisterPayload {
  registered: Boolean!
  email: String!
  expiresInSeconds: Int!
  resendAfterSeconds: Int!
}

type RequestEmailVerificationCodePayload {
  "İstek kabul edildi; hesap varlığı veya doğrulama durumu hakkında sinyal taşımaz."
  sent: Boolean!
  expiresInSeconds: Int!
  resendAfterSeconds: Int!
}

type VerifyEmailPayload {
  verified: Boolean!
  verifiedAt: Time!
}

"""Cihazın imzalaması gereken tek kullanımlık meydan okuma."""
type DeviceChallenge {
  challenge: String!
  expiresAt: Time!
}

# ---------------------------------------------------------------------------
# Sürümlenebilir içerik
# ---------------------------------------------------------------------------

enum DocumentStatus {
  """Yerinde düzenlenebilir; hiçbir oturum referans veremez."""
  DRAFT
  """Donmuş ve oynanabilir."""
  PUBLISHED
  """Donmuş ve yeni oturumlardan çekilmiş. Mevcut referanslar geçerli kalır."""
  ARCHIVED
}

"""
Bir oturumdan, oynandığı belgenin tam sürümüne işaret eden bağ.

Yalnızca soy kimliğini tutan bir referans, sonradan yayınlanan sürüme sessizce
kayardı; sertifikasyon iddiasının dayandığı şey tam olarak bunun olmamasıdır.
"""
type DocumentRef {
  lineageId: UUID!
  versionId: UUID!
  version: Int!
}

enum Difficulty {
  LOW
  MEDIUM
  HIGH
  EXTREME
}

type Character {
  id: UUID!
  lineageId: UUID!
  version: Int!
  status: DocumentStatus!
  name: String!
  "Karakterin kim olduğu. Sistem prompt'una olduğu gibi girer."
  persona: String!
  behaviorRules: [String!]!
  difficulty: Difficulty!
  """
  Karakterin sakladığı bilgiler. Çalışan doğru soruyu sorarsa açılır;
  prompt'a 'bunları kendiliğinden söyleme' talimatıyla girer.
  """
  hiddenFacts: [String!]!
  createdAt: Time!
  publishedAt: Time
}

type Criterion {
  key: String!
  title: String!
  description: String!
  weight: Float!
  maxPoints: Float!
  """
  Zorunlu kriter. Düşerse toplam puan ne olursa olsun sonuç KALDI.
  """
  mandatory: Boolean!
  """
  Karaktere talimat olarak verilen tuzak. KVKK senaryolarında karakter bunu
  kullanarak çalışandan başkasının kişisel verisini istemeye çalışır.
  """
  trap: String
}

type Rubric {
  id: UUID!
  lineageId: UUID!
  version: Int!
  status: DocumentStatus!
  name: String!
  description: String!
  "Geçme eşiği, toplam puanın yüzdesi olarak."
  passThreshold: Float!
  criteria: [Criterion!]!
  createdAt: Time!
  publishedAt: Time
}

type Scenario {
  id: UUID!
  lineageId: UUID!
  version: Int!
  status: DocumentStatus!
  title: String!
  context: String!
  objective: String!
  characterRef: DocumentRef!
  rubricRef: DocumentRef!
  maxTurns: Int!
  createdAt: Time!
  publishedAt: Time
}

# ---------------------------------------------------------------------------
# Oturum ve puanlama
# ---------------------------------------------------------------------------

enum SessionStatus {
  ACTIVE
  SCORING
  COMPLETED
  ABANDONED
}

enum TurnRole {
  EMPLOYEE
  CHARACTER
}

type Turn {
  index: Int!
  role: TurnRole!
  """
  Transkriptin kendisi: maskelenmemiş orijinal metin. Maskeleme yalnızca
  LLM'e giden kopyada yapılır, çünkü puanlama doğruluğu orijinal metne bağlı.
  """
  text: String!
  "Bu sırada tetiklenen rubrik kriter anahtarları."
  signals: [String!]!
  "LLM'e giden kopyada maskelenen kişisel veri alanı sayısı."
  maskedFieldCount: Int!
  createdAt: Time!
}

type CriterionScore {
  criterionKey: String!
  title: String!
  weight: Float!
  mandatory: Boolean!
  points: Float!
  maxPoints: Float!
  rationale: String!
  "Modelin gerekçe olarak gösterdiği transkript alıntısı."
  quote: String!
  "Alıntının geldiği konuşma sırası."
  turnIndex: Int
  """
  Alıntının o sıranın metninde gerçekten bulunup bulunmadığı. Uydurma alıntı
  ürünün güvenilirliğini bitirir; sessizce geçilmez.
  """
  quoteVerified: Boolean!
}

type ScoreOverride {
  overriddenBy: UUID!
  reason: String!
  previousTotal: Float!
  previousPassed: Boolean!
  overriddenAt: Time!
}

type Score {
  id: UUID!
  sessionId: UUID!
  total: Float!
  maxTotal: Float!
  passed: Boolean!
  """
  Zorunlu bir kriter düştüyse hangisi olduğu. Toplam puan yeterli olsa bile
  sonuç KALDI'dır ve nedeni buradadır.
  """
  failedMandatoryKeys: [String!]!
  criteria: [CriterionScore!]!
  "Puanı üreten model kimliği."
  model: String!
  """
  Skor ezme kaydı. Yetkisiz kullanıcıda null döner; çalışan sonuçları
  göremediği için bu alan yalnızca yetkili yönetici sorgularında anlamlıdır.
  """
  override: ScoreOverride @permission(requires: "score:override")
  createdAt: Time!
}

type Session {
  id: UUID!
  status: SessionStatus!
  employeeId: UUID!
  """
  Oturum başlarken dondurulan senaryo sürümü. İçerik sonradan değişse bile
  oturum kendi sürümüyle puanlanır.
  """
  scenario: DocumentRef!
  rubric: DocumentRef!
  character: DocumentRef!
  turns: [Turn!]!
  "Sonuç yalnızca puan okuma yetkisi olan kurum yöneticilerine açılır."
  score: Score @permission(requires: "score:read")
  startedAt: Time!
  endedAt: Time
}

# ---------------------------------------------------------------------------
# LLM yönetimi ve yönlendirme
# ---------------------------------------------------------------------------

enum LLMTier {
  "Her konuşma sırasında karakteri canlandırır."
  FAST
  "Oturum sonunda rubriğe göre puanlar."
  STRONG
}

type LLMProfile {
  id: UUID!
  lineageId: UUID!
  version: Int!
  status: DocumentStatus!
  tier: LLMTier!
  provider: String!
  baseUrl: String!
  "Model kimliği. Koda gömülmez; çalışma anında değiştirilebilir."
  model: String!
  temperature: Float!
  topP: Float!
  maxTokens: Int!
  """
  Yöneticinin eklediği sistem prompt eki. Sabit guardrail metnini ezemez:
  guardrail prompt derlenirken her zaman en başa gelir.
  """
  systemPromptSuffix: String!
  inputCostPer1K: Float!
  outputCostPer1K: Float!
  createdAt: Time!
}

"""Profili canlıya almadan tek seferlik deneme sonucu."""
type LLMProbeResult {
  profileId: UUID!
  model: String!
  output: String!
  latencyMs: Int!
  inputTokens: Int!
  outputTokens: Int!
  costUsd: Float!
  error: String
}

type TierStats {
  tier: LLMTier!
  calls: Int!
  avgLatencyMs: Float!
  costUsd: Float!
  inputTokens: Int!
  outputTokens: Int!
}

"""
Otomatik dağılımın kanıtı.

Grafik çizilebilir veri üretmeyen bir dağılım iddiası doğrulanamaz; bu sorgu
o veriyi üretir.
"""
type RoutingStats {
  perTier: [TierStats!]!
  "Hızlı kademenin devresi açıkken güçlüye kayan çağrı sayısı."
  failoverCount: Int!
  totalCostUsd: Float!
  "Her çağrı güçlü kademeye gitseydi oluşacak maliyet."
  allStrongCostUsd: Float!
  savingsPercent: Float!
}

type RoutingRecord {
  id: UUID!
  sessionId: UUID
  tier: LLMTier!
  "Bu kademeyi seçen kural."
  rule: String!
  model: String!
  latencyMs: Int!
  inputTokens: Int!
  outputTokens: Int!
  costUsd: Float!
  success: Boolean!
  error: String
  createdAt: Time!
}

# ---------------------------------------------------------------------------
# Denetim ve veri dışa aktarma
# ---------------------------------------------------------------------------

type AuditEntry {
  id: UUID!
  action: String!
  resourceType: String!
  resourceId: String!
  userId: UUID
  metadata: JSON
  ipAddress: String
  createdAt: Time!
}

"""
KVKK erişim hakkının karşılığı: kullanıcıya ait her şey tek belgede.
"""
type DataExport {
  exportedAt: Time!
  user: User!
  devices: [Device!]!
  sessions: [Session!]!
  auditLog: [AuditEntry!]!
  "Ham JSON gövdesi; istemci bunu dosya olarak indirir."
  document: JSON!
}

type DeletionStatus {
  requestedAt: Time
  scheduledAt: Time
  "Geri alınabilir mi. Kalıcı silme çalıştıktan sonra false."
  cancellable: Boolean!
}

# ---------------------------------------------------------------------------
# Oturum olayları (tek subscription kanalı)
# ---------------------------------------------------------------------------

enum SessionEventType {
  TRANSCRIPT_CHUNK
  RUBRIC_SIGNAL
  CHARACTER_REPLY
  SCORING_PROGRESS
  SCORE_READY
}

"""
Oturum olayları için tek kanal.

Union yerine etiketli tek tip kullanılıyor: Next.js ve Electron istemcileri
şemadan kod üretiyor, ve etiketli tip her iki üreticide de tek bir switch'e
dönüşürken union her istemcide ayrı tip guard'ları gerektirir.
"""
type SessionEvent {
  sessionId: UUID!
  type: SessionEventType!
  "TRANSCRIPT_CHUNK ve CHARACTER_REPLY için metin."
  text: String
  "CHARACTER_REPLY için konuşma sırası."
  turn: Turn
  "RUBRIC_SIGNAL için tetiklenen kriter anahtarları."
  signals: [String!]
  "SCORING_PROGRESS için 0-100 arası ilerleme."
  progress: Int
  "SCORE_READY için tamamlanmış puan; yalnızca sonuç okuma yetkisi olan yöneticilere iletilir."
  score: Score @permission(requires: "score:read")
  occurredAt: Time!
}

# ---------------------------------------------------------------------------
# Girdi tipleri
# ---------------------------------------------------------------------------

input RequestLoginCodeInput {
  email: String!
}

input RegisterInput {
  email: String!
  firstName: String!
  lastName: String!
}

input RequestEmailVerificationCodeInput {
  email: String!
}

input VerifyEmailInput {
  email: String!
  code: String!
}

input DeviceInput {
  """
  Makinenin parmak izi. Sunucuda hash'lenerek saklanır; düz metin tutulmaz.
  """
  fingerprint: String!
  name: String
  platform: String
  """
  Cihazın ürettiği açık anahtar (base64, Ed25519). Özel anahtar işletim
  sisteminin güvenli deposunda kalır ve sunucuya hiç gelmez.
  """
  publicKey: String
}

input VerifyLoginCodeInput {
  email: String!
  code: String!
  device: DeviceInput
  """
  Sunucunun verdiği challenge'ın cihaz özel anahtarıyla imzası (base64).
  Kayıtlı anahtarı olan cihazlarda zorunludur.
  """
  deviceSignature: String
}

input VerifyMagicLinkInput {
  token: String!
  device: DeviceInput
  deviceSignature: String
}

input DeviceChallengeInput {
  email: String!
  fingerprint: String!
}

input RefreshTokenInput {
  refreshToken: String!
}

input CharacterInput {
  name: String!
  persona: String!
  behaviorRules: [String!]!
  difficulty: Difficulty!
  hiddenFacts: [String!]
}

input CriterionInput {
  key: String!
  title: String!
  description: String!
  weight: Float!
  maxPoints: Float!
  mandatory: Boolean!
  trap: String
}

input RubricInput {
  name: String!
  description: String!
  passThreshold: Float!
  criteria: [CriterionInput!]!
}

input ScenarioInput {
  title: String!
  context: String!
  objective: String!
  characterLineageId: UUID!
  rubricLineageId: UUID!
  maxTurns: Int!
}

input StartSessionInput {
  scenarioLineageId: UUID!
}

input SubmitTurnInput {
  sessionId: UUID!
  "Network retry'larında aynı turn'ü iki kez uygulamamak için istemci anahtarı."
  requestId: UUID
  text: String!
}

input OverrideScoreInput {
  scoreId: UUID!
  total: Float!
  passed: Boolean!
  reason: String!
}

input LLMProfileInput {
  tier: LLMTier!
  provider: String!
  baseUrl: String!
  model: String!
  temperature: Float!
  topP: Float!
  maxTokens: Int!
  systemPromptSuffix: String
  inputCostPer1K: Float!
  outputCostPer1K: Float!
}

input TestLLMProfileInput {
  profileLineageId: UUID!
  prompt: String!
}

input UpdateProfileInput {
  firstName: String
  lastName: String
}

# ---------------------------------------------------------------------------
# Kök tipler
# ---------------------------------------------------------------------------

type Query {
  me: User @auth
  myDevices: [Device!]! @auth
  mySessions(limit: Int = 20, offset: Int = 0): [Session!]! @auth
  session(id: UUID!): Session @auth

  scenarios(publishedOnly: Boolean = true): [Scenario!]! @auth
  scenario(lineageId: UUID!, version: Int): Scenario @auth
  characters(publishedOnly: Boolean = true): [Character!]! @auth
  character(lineageId: UUID!, version: Int): Character @auth
  rubrics(publishedOnly: Boolean = true): [Rubric!]! @auth
  rubric(lineageId: UUID!, version: Int): Rubric @auth

  llmProfiles: [LLMProfile!]! @auth @permission(requires: "llm:read")
  routingStats(from: Time, to: Time): RoutingStats! @auth @permission(requires: "routing:read")
  routingRecords(sessionId: UUID, limit: Int = 50): [RoutingRecord!]! @auth @permission(requires: "routing:read")
  auditLog(limit: Int = 50, offset: Int = 0): [AuditEntry!]! @auth @permission(requires: "audit:read")

  deletionStatus: DeletionStatus @auth
}

type Mutation {
  # --- kimlik ---
  register(input: RegisterInput!): RegisterPayload!
  requestEmailVerificationCode(input: RequestEmailVerificationCodeInput!): RequestEmailVerificationCodePayload!
  verifyEmail(input: VerifyEmailInput!): VerifyEmailPayload!
  requestLoginCode(input: RequestLoginCodeInput!): RequestLoginCodePayload!
  verifyLoginCode(input: VerifyLoginCodeInput!): AuthPayload!
  verifyMagicLink(input: VerifyMagicLinkInput!): AuthPayload!
  requestDeviceChallenge(input: DeviceChallengeInput!): DeviceChallenge!
  refreshToken(input: RefreshTokenInput!): AuthPayload!
  logout: Boolean! @auth
  revokeDevice(deviceId: UUID!): Boolean! @auth

  # --- içerik ---
  createCharacter(input: CharacterInput!): Character! @auth @permission(requires: "content:write")
  updateCharacter(lineageId: UUID!, input: CharacterInput!): Character! @auth @permission(requires: "content:write")
  publishCharacter(lineageId: UUID!, version: Int!): Character! @auth @permission(requires: "content:publish")

  createScenario(input: ScenarioInput!): Scenario! @auth @permission(requires: "content:write")
  updateScenario(lineageId: UUID!, input: ScenarioInput!): Scenario! @auth @permission(requires: "content:write")
  publishScenario(lineageId: UUID!, version: Int!): Scenario! @auth @permission(requires: "content:publish")

  createRubric(input: RubricInput!): Rubric! @auth @permission(requires: "content:write")
  updateRubric(lineageId: UUID!, input: RubricInput!): Rubric! @auth @permission(requires: "content:write")
  publishRubric(lineageId: UUID!, version: Int!): Rubric! @auth @permission(requires: "content:publish")

  # --- oturum ---
  startSession(input: StartSessionInput!): Session! @auth
  submitTurn(input: SubmitTurnInput!): Turn! @auth
  endSession(sessionId: UUID!): Session! @auth
  overrideScore(input: OverrideScoreInput!): Score! @auth @permission(requires: "score:override")

  # --- LLM yönetimi ---
  updateLLMProfile(lineageId: UUID!, input: LLMProfileInput!): LLMProfile! @auth @permission(requires: "llm:write")
  createLLMProfile(input: LLMProfileInput!): LLMProfile! @auth @permission(requires: "llm:write")
  publishLLMProfile(lineageId: UUID!, version: Int!): LLMProfile! @auth @permission(requires: "llm:write")
  testLLMProfile(input: TestLLMProfileInput!): LLMProbeResult! @auth @permission(requires: "llm:write")

  # --- hesap yaşam döngüsü ---
  updateProfile(input: UpdateProfileInput!): User! @auth
  exportMyData: DataExport! @auth
  requestAccountDeletion: DeletionStatus! @auth
  cancelAccountDeletion: DeletionStatus! @auth
}

type Subscription {
  """
  Oturumun canlı olay akışı.

  Sahiplik bağlantı anında doğrulanır: kendi oturumu olmayan bir kullanıcı
  akışa hiç bağlanamaz, çünkü transkript kişisel veri taşır.
  """
  sessionEvents(sessionId: UUID!): SessionEvent! @auth
}
